@page
@model SaaSAgentSample.Web.Pages.IndexModel
@{
    ViewData["Title"] = (Model.ShowHome ? L["Start here"] : Model.IsActivated ? L["Activation complete"] :
        Model.AlreadyActive ? L["Return to your subscription"] : L["Activate your subscription"]).Value;
    var r = Model.Resolved;
    var sub = r?.Subscription;
    var signedIn = User?.Identity?.IsAuthenticated == true;
    var adminUrl = DemoNavigation.PublisherLink("/admin", Model.DemoScenario);
    var saved = Model.SavedSubscription;
    var savedUrl = saved is null ? null : DemoNavigation.PublisherLink($"/admin/{saved.Id}", Model.DemoScenario);

    // What the map may tick off. Arriving with a purchase token is proof step 1 happened; an
    // activated subscription is proof step 2 did. The home page proves nothing yet.
    if (!Model.ShowHome && (r is not null || Model.IsActivated))
    {
        ViewData["DemoCompletedThrough"] = (Model.IsActivated || Model.AlreadyActive) ? 2 : 1;
    }
}
@if (Model.ShowHome)
{
    <h1 class="page-title">@L["Start here"]</h1>
    <p class="subtitle">@L["Choose a service, complete a purchase, and follow it to activation on the partner site."]</p>

    @if (Model.EmulatorUrl is not null)
    {
        <p class="cta-line">
            <a class="btn primary" href="@Model.EmulatorUrl" target="_blank" rel="noopener">@L["Start the purchase experience →"]</a>
        </p>
    }
    else
    {
        <p class="notice">@L["To begin, open your Fulfillment API Emulator and use its Marketplace tab."]</p>
    }

    <details class="explainer learn" id="boundary">
        <summary>@L["View the whole flow"]</summary>
        <div class="body">@(await Html.PartialAsync("_ResponsibilityMap"))</div>
    </details>
}
else
{
    <h1 class="page-title">@(Model.IsActivated ? L["Activation complete"] : Model.AlreadyActive ? L["Return to your subscription"] : L["Activate your subscription"])</h1>
    @if (!Model.IsActivated)
    {
    <p class="subtitle">@(Model.AlreadyActive
        ? L["This purchase is already active. Returning here does not activate it again."]
        : L["Review the plan below, then confirm. Activation starts billing."])</p>
    }

    @if (Model.DemoScenario is not null && !Model.IsActivated && !Model.AlreadyActive)
    {
        <aside class="purchase-arrival" aria-label="@L["Illustrative purchase route"]">
            <span>@L["Microsoft checkout"]</span>
            <span aria-hidden="true">→</span>
            <strong>@L["You are now on the partner company's site"]</strong>
        </aside>
    }

    @if (signedIn)
    {
        <p class="muted">@L["Signed in as {0}", User!.Identity!.Name!]</p>
    }

    @if (Model.IsActivated || Model.AlreadyActive)
    {
        <div class="banner buyer-result" role="status">
            <span class="ico" aria-hidden="true">&#10003;</span>
            <div>
                <strong>@(Model.IsActivated ? L["Activated."] : L["Already active."])</strong>
                <p>@L["This completes the buyer walkthrough. Product access is not implemented by this sample."]</p>
            </div>
        </div>
        <details class="explainer learn behind-scenes" id="behind-scenes">
            <summary>@L["See behind the partner site"]</summary>
            <div class="body">
                <h2 class="learn-h">@L["What happened"]</h2>
                <p>@(Model.IsActivated ? L["Microsoft accepted activation. The partner result is recorded separately below."] : L["Microsoft returned an already active purchase. The partner record is shown separately."])</p>
                @if (saved is not null)
                {
                    <dl class="kv saved-result">
                        <dt>@L["Partner saved state"]</dt><dd>@saved.State</dd>
                        <dt>@L["Plan"]</dt><dd>@saved.PlanId</dd>
                        <dt>@L["Updated (UTC)"]</dt><dd>@saved.UpdatedAt.UtcDateTime.ToString("u")</dd>
                    </dl>
                    <p><a class="btn secondary saved-record-link" href="@savedUrl">@L["View this saved contract →"]</a></p>
                }
                else
                {
                    <p>@L["No saved partner record was found for this purchase."]</p>
                    <a href="@adminUrl">@L["View all saved contracts"]</a>
                }
            </div>
        </details>
    }
    else if (r is not null)
    {
        @* Markers are status, not numbers: the map above already owns the numbering, and a second
           1-2-3 next to it was exactly the kind of double scheme that made this confusing. *@
        <ol class="substeps" aria-label="@L["Activation progress"]">
            <li class="@(signedIn ? "done" : null)" aria-label="@L["Sign in"]: @(signedIn ? L["Completed"] : L["Not signed in"])">
                <span class="ss-n" aria-hidden="true"></span>
                <span class="ss-label">@L["Sign in"]</span>
                <span class="ss-next" aria-hidden="true">→</span>
            </li>
            <li class="done" aria-label="@L["Purchase details"]: @L["Completed"]">
                <span class="ss-n" aria-hidden="true"></span>
                <span class="ss-label">@L["Purchase details"]</span>
                <span class="ss-next" aria-hidden="true">→</span>
            </li>
            <li class="now" aria-current="step">
                <span class="ss-n" aria-hidden="true"></span>
                <span class="ss-label">@L["Activate"]</span>
            </li>
        </ol>

        <div class="card activation-card">
            <h2>@L["Confirm activation"]</h2>
            <dl class="kv">
                <dt>@L["Subscription"]</dt><dd>@(r.SubscriptionName ?? sub?.Name)</dd>
                <dt>@L["Offer"]</dt><dd>@(r.OfferId ?? sub?.OfferId)</dd>
                <dt>@L["Plan"]</dt><dd>@(r.PlanId ?? sub?.PlanId)</dd>
                <dt>@L["Quantity"]</dt><dd>@(r.Quantity?.ToString() ?? "—")</dd>
                <dt>@L["Status"]</dt><dd><span class="badge pending">@sub?.SaasSubscriptionStatus</span></dd>
            </dl>
            <p class="hint">@L["The partner company links this contract to its existing user or customer-company ID."]</p>
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="subscriptionId" value="@(sub?.Id ?? r.Id)" />
                <input type="hidden" name="planId" value="@(r.PlanId ?? sub?.PlanId)" />
                @if (r.Quantity is int q)
                {
                    <input type="hidden" name="quantity" value="@q" />
                }
                <button type="submit" class="btn primary">@L["Activate subscription"]</button>
            </form>
        </div>

    }
    else
    {
        <div class="card"><p class="muted">@(Model.Message ?? L["Nothing to show."].Value)</p></div>
    }
    <details class="explainer learn" id="boundary">
        <summary>@L["Responsibility map"]</summary>
        <div class="body">@(await Html.PartialAsync("_ResponsibilityMap"))</div>
    </details>
}
