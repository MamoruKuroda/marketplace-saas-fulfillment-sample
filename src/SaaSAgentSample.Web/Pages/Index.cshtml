@page
@model SaaSAgentSample.Web.Pages.IndexModel
@{
    ViewData["Title"] = (Model.ShowHome ? L["Start here"] : L["Activate your subscription"]).Value;
    var r = Model.Resolved;
    var sub = r?.Subscription;
    var signedIn = User?.Identity?.IsAuthenticated == true;

    // What the map may tick off. Arriving with a purchase token is proof step 1 happened; an
    // activated subscription is proof step 2 did. The home page proves nothing yet.
    if (!Model.ShowHome && r is not null)
    {
        ViewData["DemoCompletedThrough"] = (Model.IsActivated || Model.AlreadyActive) ? 2 : 1;
    }
}
@if (Model.ShowHome)
{
    <h1 class="page-title">@L["Start here"]</h1>
    <p class="subtitle">@L["A hands-on tour of a Marketplace SaaS purchase — the map above is the whole demo."]</p>

    @if (Model.EmulatorUrl is not null)
    {
        <p class="cta-line">
            <a class="btn primary" href="@Model.EmulatorUrl" target="_blank" rel="noopener">@L["Step 1 — buy in the Marketplace (opens the emulator) →"]</a>
            <span class="hint">@L["The emulator plays Microsoft. Buy there, and it sends you back here to activate."]</span>
        </p>
    }
    else
    {
        <p class="notice">@L["To begin, open your Fulfillment API Emulator and use its Marketplace tab."]</p>
    }

    <details class="explainer learn" id="how">
        <summary>@L["How this works"]</summary>
        <div class="body">
            <h3 class="learn-h">@L["Who's who"]</h3>
            <div class="actors">
                <div class="actor">
                    <span class="who ms">@L["Marketplace"]</span>
                    <h3>@L["Microsoft"]</h3>
                    <p>@L["Runs the marketplace and the billing. The emulator stands in for it here."]</p>
                </div>
                <div class="actor">
                    <span class="who pub">@L["This app"]</span>
                    <h3>@L["Publisher (you)"]</h3>
                    <p>@L["Sells the offer. Builds steps 2 and 3, plus the webhook that carries step 4 back to step 3."]</p>
                </div>
                <div class="actor">
                    <span class="who buyer">@L["Different tenant"]</span>
                    <h3>@L["Buyer"]</h3>
                    <p>@L["Purchases from the Marketplace, then signs in on the landing page to activate."]</p>
                </div>
            </div>
            @(await Html.PartialAsync("_KeyTerms"))
        </div>
    </details>
}
else
{
    <h1 class="page-title">@L["Activate your subscription"]</h1>
    <p class="subtitle">@L["Review the plan below, then confirm. Activation starts billing."]</p>

    @if (signedIn)
    {
        <p class="muted">@L["Signed in as {0}", User!.Identity!.Name!]</p>
    }

    @if (Model.IsActivated || Model.AlreadyActive)
    {
        @* One primary action — step 3 — because that is the single next thing to do. Step 4 comes
           after it, so it is a quiet note rather than a second link of equal weight. *@
        <div class="banner">
            <span class="ico">&#10003;</span>
            <div>
                <strong>@(Model.IsActivated ? L["Activated."] : L["Already active."])</strong> @Model.Message
                <p class="banner-next">@L["Next: open the publisher admin and confirm the status now reads Subscribed."]</p>
                <p class="banner-cta"><a class="btn primary" href="/admin">@L["Open the publisher admin (step 3) →"]</a></p>
                @if (Model.EmulatorUrl is not null)
                {
                    <p class="banner-later">
                        @L["After that, step 4: act on it in the emulator and the change arrives here as a webhook."]
                        <a href="@Model.EmulatorSubscriptionsUrl" target="_blank" rel="noopener">@L["Open the emulator's Subscriptions tab →"]</a>
                    </p>
                }
            </div>
        </div>
    }
    else if (r is not null)
    {
        <p class="notice">@L["Only this one screen has to be a web page — your desktop or client app stays as it is."]</p>

        @* Markers are status, not numbers: the map above already owns the numbering, and a second
           1-2-3 next to it was exactly the kind of double scheme that made this confusing. *@
        <ol class="substeps">
            <li class="@(signedIn ? "done" : null)">
                <span class="ss-n" aria-hidden="true"></span>
                <div>
                    <strong>@L["Sign in"]</strong>
                    <p>@L["Entra single sign-on, required by Microsoft on this page."]</p>
                </div>
            </li>
            <li class="done">
                <span class="ss-n" aria-hidden="true"></span>
                <div>
                    <strong>@(await Html.PartialAsync("_Term", SaaSAgentSample.Web.TermVm.Resolve(L)))</strong>
                    <p>@L["Purchase token traded for the real details — done, shown below."]</p>
                </div>
            </li>
            <li class="now">
                <span class="ss-n" aria-hidden="true"></span>
                <div>
                    <strong>@(await Html.PartialAsync("_Term", SaaSAgentSample.Web.TermVm.Activate(L)))</strong>
                    <p>@L["Tells Microsoft fulfillment is done, which starts billing."]</p>
                    <p class="ss-link">@L["Also where you link this subscription to your own company account — Microsoft cannot hold that."]</p>
                </div>
            </li>
        </ol>

        <div class="card">
            <h2>@L["Confirm activation"]</h2>
            <dl class="kv">
                <dt>@L["Subscription"]</dt><dd>@(r.SubscriptionName ?? sub?.Name)</dd>
                <dt>@L["Offer"]</dt><dd>@(r.OfferId ?? sub?.OfferId)</dd>
                <dt>@L["Plan"]</dt><dd>@(r.PlanId ?? sub?.PlanId)</dd>
                <dt>@L["Quantity"]</dt><dd>@(r.Quantity?.ToString() ?? "—")</dd>
                <dt>@L["Status"]</dt><dd><span class="badge pending">@sub?.SaasSubscriptionStatus</span></dd>
            </dl>
            <form method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="subscriptionId" value="@(sub?.Id ?? r.Id)" />
                <input type="hidden" name="planId" value="@(r.PlanId ?? sub?.PlanId)" />
                @if (r.Quantity is int q)
                {
                    <input type="hidden" name="quantity" value="@q" />
                }
                <button type="submit" class="btn primary">@L["Activate subscription"]</button>
            </form>
            <p class="hint" style="margin:.9rem 0 0">@L["Offers can also auto-activate, skipping this page."]</p>
        </div>

        <details class="explainer learn" id="how">
            <summary>@L["How this works"]</summary>
            <div class="body">@(await Html.PartialAsync("_KeyTerms"))</div>
        </details>
    }
    else
    {
        <div class="card"><p class="muted">@(Model.Message ?? L["Nothing to show."].Value)</p></div>
    }
}
