@using SaaSAgentSample.Core.Subscriptions
@using SaaSAgentSample.Web.Services
@model SaaSAgentSample.Web.ProvenanceVm
@{
    // Element 6: what wrote this state, and when. Part of the ledger — see ISubscriptionEventLog.
    // A subscription written before the trail was made durable has no entries, so fall back to
    // what the current state alone can tell us, and say plainly that it is inferred.
    string SourceLabel(SubscriptionEventSource source) => source switch
    {
        SubscriptionEventSource.Landing => L["2 · Landing page (at start)"].Value,
        SubscriptionEventSource.Admin => L["3 · Publisher admin (at start)"].Value,
        _ => L["4→3 · Webhook (in operation)"].Value,
    };

    // Action names are Fulfillment API terms (Resolve, Activate, Suspend, ChangePlan …) and are
    // left untranslated, like the state names.
    var inferred = Model.Events.Count == 0;
    var fallbackSource = Model.State switch
    {
        SubscriptionState.PendingFulfillmentStart => L["2 · Landing page (at start)"].Value,
        SubscriptionState.Subscribed => L["Activate at start, or a webhook in operation"].Value,
        _ => L["4→3 · Webhook (in operation)"].Value,
    };
    var fallbackAction = Model.State switch
    {
        SubscriptionState.PendingFulfillmentStart => "Resolve",
        SubscriptionState.Suspended => "Suspend",
        SubscriptionState.Unsubscribed => "Unsubscribe",
        _ => "—",
    };
}
@if (Model.Compact)
{
    <span class="prov compact">
        @if (inferred)
        {
            <span class="prov-src">@fallbackSource</span> <span class="prov-act">@fallbackAction</span>
            <span class="prov-inferred">@L["inferred"]</span>
        }
        else
        {
            var latest = Model.Events[0];
            <span class="prov-src">@SourceLabel(latest.Source)</span> <span class="prov-act">@latest.Action</span>
            @if (!string.IsNullOrEmpty(latest.Detail))
            {
                <span class="prov-detail">@latest.Detail</span>
            }
        }
    </span>
}
else
{
    <div class="prov full">
        <h3 class="prov-h">@L["What changed this, and when"]</h3>
        @if (inferred)
        {
            <p class="muted prov-empty">
                @L["No entry recorded for this subscription — inferred from its current state:"]
                <span class="prov-src">@fallbackSource</span> <span class="prov-act">@fallbackAction</span>
            </p>
        }
        else
        {
            <ol class="prov-list">
                @foreach (var e in Model.Events)
                {
                    <li>
                        <span class="prov-src">@SourceLabel(e.Source)</span>
                        <span class="prov-act">@e.Action</span>
                        @if (!string.IsNullOrEmpty(e.Detail))
                        {
                            <span class="prov-detail">@e.Detail</span>
                        }
                        <time class="muted">@e.At.UtcDateTime.ToString("u")</time>
                    </li>
                }
            </ol>
        }
        <p class="prov-note">@L["Stored with the subscription and written in the same transaction as the state change, so a state can never lose its cause."]</p>
    </div>
}
