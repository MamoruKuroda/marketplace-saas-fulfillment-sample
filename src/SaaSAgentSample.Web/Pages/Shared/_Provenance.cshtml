@using SaaSAgentSample.Core.Subscriptions
@using SaaSAgentSample.Web.Services
@model SaaSAgentSample.Web.ProvenanceVm
@{
    // Element 6: what wrote this state, and when. Part of the ledger — see ISubscriptionEventLog.
    //
    // The sentence leads and the Fulfillment API term follows as a tag. Leading with the term
    // ("Suspend") hid the meaning, and was also less precise than plain language: the docs say
    // Suspend means a payment was not received, and Unsubscribe covers both an explicit
    // cancellation and an implicit one after the 30-day unpaid grace period — so naming a culprit
    // would be wrong. Actions arrive from the payload with the sender's casing, so match
    // case-insensitively.
    string Say(SubscriptionEventSource source, string action) => (source, action.ToLowerInvariant()) switch
    {
        (SubscriptionEventSource.Landing, "resolve") => L["2 · Purchase token exchanged for the real subscription"].Value,
        (SubscriptionEventSource.Landing, "activate") => L["2 · Activated from the landing page — billing starts"].Value,
        (SubscriptionEventSource.Admin, _) => L["3 · Activated from the publisher admin — billing starts"].Value,
        (_, "suspend") => L["4→3 · Suspended — a payment was not received"].Value,
        (_, "unsubscribe") => L["4→3 · Cancelled"].Value,
        (_, "reinstate") => L["4→3 · Reinstated — payment resumed"].Value,
        (_, "changeplan") => L["4→3 · Moved to another plan"].Value,
        (_, "changequantity") => L["4→3 · Number of licences changed"].Value,
        (_, "renew") => L["4→3 · Renewed — the state does not change"].Value,
        (_, "subscribe") => L["4→3 · Purchase announced — the state does not change"].Value,
        _ => L["4→3 · Microsoft sent a notification"].Value,
    };

    // Subscriptions stored before the trail was durable have no entries. Nothing is deduced from
    // the state here on purpose: a guess dressed as a record is what made this column hard to
    // trust in the first place.
    var noTrail = Model.Events.Count == 0;
}
@if (Model.Compact)
{
    <span class="prov compact">
        @if (noTrail)
        {
            <span class="prov-none">@L["No entry — stored before this app kept a trail"]</span>
        }
        else
        {
            var latest = Model.Events[0];
            <span class="prov-say">@Say(latest.Source, latest.Action)</span>
            <span class="prov-act">@latest.Action</span>
            @if (!string.IsNullOrEmpty(latest.Detail))
            {
                <span class="prov-detail">@latest.Detail</span>
            }
        }
    </span>
}
else
{
    <div class="prov full">
        <h3 class="prov-h">@L["What changed this, and when"]</h3>
        @if (noTrail)
        {
            <p class="muted prov-empty">@L["No entry — stored before this app kept a trail"]</p>
        }
        else
        {
            <ol class="prov-list">
                @foreach (var e in Model.Events)
                {
                    <li>
                        <span class="prov-say">@Say(e.Source, e.Action)</span>
                        <span class="prov-act">@e.Action</span>
                        @if (!string.IsNullOrEmpty(e.Detail))
                        {
                            <span class="prov-detail">@e.Detail</span>
                        }
                        <time class="muted">@e.At.UtcDateTime.ToString("u")</time>
                    </li>
                }
            </ol>
        }
        <p class="prov-note">@L["Stored with the subscription and written in the same transaction as the state change, so a state can never lose its cause."]</p>
    </div>
}
