@{
    // Element 6: why the publisher needs a database at all, when Microsoft already holds the
    // subscription. Renders bare so the caller decides how to group it.
}
<h3 class="learn-h">@L["Why does the partner company keep a contract database?"]</h3>
<div class="truth-cols">
    <div class="truth-col ms">
        <span class="who ms">@L["Microsoft"]</span>
        <h4>@L["The commercial fact"]</h4>
        <ul>
            <li>@L["Purchased, active, suspended, cancelled"]</li>
            <li>@L["Plan and quantity"]</li>
            <li>@L["Invoicing the customer"]</li>
        </ul>
        <p class="foot-note">@L["Upstream. Re-read it any time with GET /subscriptions/{id}."]</p>
    </div>
    <div class="truth-arrows" aria-hidden="true">
        <span class="ta">@L["at start: Resolve / Activate"]</span>
        <span class="ta">@L["in operation: Webhook"]</span>
        <span class="ta back">@L["re-read any time"]</span>
    </div>
    <div class="truth-col pub">
        <span class="who pub">@L["Partner company (SaaS publisher)"]</span>
        <h4>@L["Partner company side"]</h4>
        <ul>
            <li>@L["A synced copy of the commercial state"]</li>
            <li>@L["Mapping to customer-company accounts and users"]</li>
            <li>@L["Provisioned resources and customer data"]</li>
        </ul>
        <p class="foot-note">@L["Product-specific account mappings belong to the partner company."]</p>
    </div>
</div>
<p class="learn-foot">@L["Microsoft is upstream. Notifications are checked against the Operations API before the partner company's database is updated."]</p>
