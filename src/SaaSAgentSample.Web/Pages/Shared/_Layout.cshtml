@using System.Globalization
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    var onAdmin = path.StartsWith("/admin");
    var cur = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var htmlLang = cur == "ja" ? "ja" : "en";
    var scenario = DemoNavigation.PurchaseScenario(Context.Request.Query["scenario"].ToString());
    var homeUrl = DemoNavigation.PublisherLink("/", scenario);
    var adminUrl = DemoNavigation.PublisherLink("/admin", scenario);
    var hasToken = !string.IsNullOrEmpty(Context.Request.Query["token"]);
    var isHome = !onAdmin && path == "/" && !hasToken;

    // This compact guide is teaching navigation, separate from each product's header and controls.
    int? demoStep = onAdmin ? 3 : (path == "/" && hasToken ? 2 : (int?)null);
    var mapDetail = SaaSAgentSample.Web.DemoMapDetail.CurrentOnly;
    var emulatorPurchase = DemoNavigation.EmulatorLink(Config, DemoNavigation.PurchaseEntryPath, scenario);
    var emulatorEvents = DemoNavigation.EmulatorLink(Config, "/subscriptions.html", scenario);
    var boundaryUrl = DemoNavigation.PublisherLink("/#boundary", scenario);
    var area = onAdmin ? "operations" : isHome ? "overview" : "buyer";

    // Pages report how far the visitor has actually got, so the map can tick off what is done and
    // point at what is next. Set from evidence only — see each page for what it counts as proof.
    var completedThrough = ViewData["DemoCompletedThrough"] as int?;
}
<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Marketplace SaaS sample")</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body class="partner-page area-@area">
    <a class="skip-link" href="#main-content">@L["Skip to content"]</a>
    <div class="orient-bar teaching-guide">
        <div class="guide-inner">
            <a class="guide-title" href="@homeUrl">@L["Teaching guide"]</a>
            @(await Html.PartialAsync("_DemoNotice"))
            @(await Html.PartialAsync("_DemoMap", new SaaSAgentSample.Web.DemoMapVm(demoStep, mapDetail, completedThrough)))
            <a class="boundary-link" href="@boundaryUrl">@L["Responsibility map"]</a>
            <details class="demo-role-switch">
                <summary>@L["Demonstration role switch"]</summary>
                <div class="role-menu">
                    @if (emulatorPurchase is not null)
                    {
                        <a href="@emulatorPurchase" target="_blank" rel="noopener">@L["Buyer — simulated Microsoft purchase ↗"]</a>
                    }
                    <a href="@homeUrl">@L["Overview — start the buyer journey here"]</a>
                    <a href="@adminUrl">@L["Operator — partner company contract DB"]</a>
                    @if (emulatorEvents is not null)
                    {
                        <a href="@emulatorEvents" target="_blank" rel="noopener">@L["Demo operator — trigger Microsoft-side events ↗"]</a>
                    }
                </div>
            </details>
        </div>
    </div>
    <header class="site-header">
        <div class="bar">
            <div class="brand">
                <span class="area-icon" aria-hidden="true">
                    @if (onAdmin)
                    {
                        <svg viewBox="0 0 24 24"><ellipse cx="12" cy="5" rx="8" ry="3" /><path d="M4 5v14c0 4 16 4 16 0V5M4 12c0 4 16 4 16 0" /></svg>
                    }
                    else
                    {
                        <svg viewBox="0 0 24 24"><path d="M3 8l9-5 9 5-9 5-9-5M3 12l9 5 9-5M3 16l9 5 9-5" /></svg>
                    }
                </span>
                <span>@(onAdmin ? L["Example operations UI implemented by the partner company"] : isHome ? L["Marketplace SaaS teaching sample"] : L["Partner company service"])
                    <small>@(onAdmin ? L["Partner company administration / for operators"] : isHome ? L["Purchase to activation"] : L["Partner company site / for buyers"])</small>
                </span>
            </div>
                <nav class="lang" aria-label="@L["Language"]">
                    <a href="/set-culture?culture=en&amp;redirect=@Uri.EscapeDataString(DemoNavigation.WithCulture(returnUrl, "en"))" class="@(cur == "ja" ? "" : "active")" aria-current="@(cur != "ja" ? "true" : null)">EN</a>
                    <a href="/set-culture?culture=ja&amp;redirect=@Uri.EscapeDataString(DemoNavigation.WithCulture(returnUrl, "ja"))" class="@(cur == "ja" ? "active" : "")" aria-current="@(cur == "ja" ? "true" : null)">日本語</a>
                </nav>
        </div>
        @if (!isHome)
        {
        <div class="area-context" aria-label="@L["Location and responsibility"]">
            <dl>
                <div><dt>@L["Operated by"]</dt><dd>@(onAdmin ? L["Partner company operator"] : isHome ? L["Demo participant"] : L["Buyer"])</dd></div>
                <div><dt>@L["Implemented in production by"]</dt><dd>@(isHome ? L["Teaching aid only"] : L["Partner company (SaaS publisher)"])</dd></div>
            </dl>
        </div>
        }
    </header>
    <div class="partner-shell">
        @if (onAdmin)
        {
            <aside class="partner-sidebar">
                <nav aria-label="@L["Operations navigation"]">
                    <a href="@adminUrl" aria-current="@(path == "/admin" ? "page" : null)">@L["Subscriptions"]</a>
                    <a href="@boundaryUrl">@L["Responsibility map"]</a>
                </nav>
            </aside>
        }
    <main id="main-content" tabindex="-1">
        @RenderBody()
    </main>
    </div>
    <footer class="site-footer">
        <a class="implementation-guide" id="how" href="@DemoNavigation.ImplementationGuideUrl" target="_blank" rel="noopener noreferrer">@L["Implementation guide ↗"]</a>
    </footer>
    <script src="/js/site.js" defer></script>
</body>
</html>
