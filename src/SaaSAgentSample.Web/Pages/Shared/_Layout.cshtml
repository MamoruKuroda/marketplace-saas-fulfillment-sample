@using System.Globalization
@{
    var path = (Context.Request.Path.Value ?? "/").ToLowerInvariant();
    var onAdmin = path.StartsWith("/admin");
    var cur = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var htmlLang = cur == "ja" ? "ja" : "en";
    var hasToken = !string.IsNullOrEmpty(Context.Request.Query["token"]);
    var isHome = !onAdmin && path == "/" && !hasToken;
    int? demoStep = onAdmin ? 3 : (path == "/" && hasToken ? 2 : (int?)null);

    // Which of the three roles and which of the three parts this page is. The home page is the
    // map of all of them, so it claims neither. The webhook is never "current" because it has no
    // page — consistent with steps 1 and 4, which live in the emulator.
    var role = onAdmin
        ? SaaSAgentSample.Web.DemoRole.Publisher
        : (hasToken ? SaaSAgentSample.Web.DemoRole.Buyer : SaaSAgentSample.Web.DemoRole.None);
    var part = onAdmin
        ? SaaSAgentSample.Web.BuildPart.StateStore
        : (hasToken ? SaaSAgentSample.Web.BuildPart.Landing : SaaSAgentSample.Web.BuildPart.None);
}
<!DOCTYPE html>
<html lang="@htmlLang">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Marketplace SaaS sample")</title>
    <link rel="stylesheet" href="/css/site.css" />
</head>
<body>
    <header class="site-header">
        <div class="bar">
            <a class="brand" href="/"><span class="logo">M</span><span>Marketplace SaaS sample<small>@L["Publisher-side app"]</small></span></a>
            <nav class="top">
                <a href="/" class="@(onAdmin ? "" : "active")" aria-current="@(!onAdmin ? "page" : null)">@L["Home"]</a>
                <a href="/admin" class="@(onAdmin ? "active" : "")" aria-current="@(onAdmin ? "page" : null)">@L["Publisher admin"]</a>
                <span class="lang" role="navigation" aria-label="@L["Language"]">
                    <a href="/set-culture?culture=en&amp;redirect=@Uri.EscapeDataString(returnUrl)" class="@(cur == "ja" ? "" : "active")" aria-current="@(cur != "ja" ? "true" : null)">EN</a>
                    <a href="/set-culture?culture=ja&amp;redirect=@Uri.EscapeDataString(returnUrl)" class="@(cur == "ja" ? "active" : "")" aria-current="@(cur == "ja" ? "true" : null)">日本語</a>
                </span>
            </nav>
        </div>
    </header>
    @(await Html.PartialAsync("_HeroLine"))
    @if (!isHome && demoStep != null)
    {
        <div class="stepper-bar">
            @(await Html.PartialAsync("_DemoMap", new SaaSAgentSample.Web.DemoMapVm(demoStep, false)))
        </div>
    }
    <div class="teach-strip">
        <div class="inner">
            @(await Html.PartialAsync("_BuildParts", new SaaSAgentSample.Web.BuildPartsVm(part, false)))
            @(await Html.PartialAsync("_RoleBadges", new SaaSAgentSample.Web.RoleBadgeVm(role)))
        </div>
    </div>
    <main>
        @RenderBody()
    </main>
    <footer class="site-footer">@L["Experimental teaching sample — not for production use."]</footer>
    <script src="/js/site.js" defer></script>
</body>
</html>
