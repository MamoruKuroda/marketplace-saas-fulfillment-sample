@model SaaSAgentSample.Web.RoleBadgeVm
@{
    // Element 3: who you are on this page. One chip, not three — the full three-role mapping is
    // taught once on the home page, so repeating it on every screen was noise. The mapping stays
    // reachable on hover/focus.
    var (css, label) = Model.Current switch
    {
        SaaSAgentSample.Web.DemoRole.Microsoft => ("ms", L["Microsoft"].Value),
        SaaSAgentSample.Web.DemoRole.Publisher => ("pub", L["Publisher (you)"].Value),
        SaaSAgentSample.Web.DemoRole.Buyer => ("buyer", L["Buyer"].Value),
        _ => ("all", L["all three roles"].Value),
    };
}
<span class="rb @css" title="@L["Steps 1 and 4 are Microsoft (the emulator); steps 2 and 3 are this app."]">
    <span class="chip-cap">@L["You are"]</span>@label
</span>
