@model string
@{
    var route = Model switch
    {
        "web-card" => L["Marketplace Web → card checkout"],
        "web-azure" => L["Marketplace Web → Azure portal checkout"],
        "azure-portal" => L["Azure portal → Azure subscription checkout"],
        _ => null,
    };
}
@if (route is not null)
{
    <aside class="purchase-route-details" aria-label="@L["Illustrative purchase route"]">
        <span class="purchase-context-label">@L["Illustrative purchase route"]</span>
        <p><strong>@route</strong> <span aria-hidden="true">→</span> @L["The same publisher landing page"]</p>
        <p class="muted">@L["The partner company implements this destination, not Microsoft's checkout. The route label does not verify payment or permissions."]</p>
    </aside>
}
