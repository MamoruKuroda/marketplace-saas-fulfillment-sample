<details class="learning-focus" id="learning-interests">
    <summary>@L["Choose what to explore (optional)"]</summary>
    <label for="learning-focus">@L["Your interests — not your role in the demo"]</label>
    <select id="learning-focus" name="learning-focus" data-learning-focus>
        <option value="business">@L["Business and sales"]</option>
        <option value="buyer">@L["Buying organization"]</option>
        <option value="implementation">@L["Implementation"]</option>
        <option value="operations">@L["Operations"]</option>
    </select>
    <div class="focus-notes" aria-live="polite">
        <p data-focus-note="business">@L["Follow what the customer buys, where setup starts, and what activation completes. No API knowledge is needed."]</p>
        <p data-focus-note="buyer">@L["Follow purchase, account setup and the confirmation. Purchase permission and service access are separate."]</p>
        <p data-focus-note="implementation">@L["Expand implementation details to connect the observed result to partner code, API calls and storage."]</p>
        <p data-focus-note="operations">@L["Inspect the saved record, trigger one change, then compare stored plan, state and event history."]</p>
    </div>
</details>
