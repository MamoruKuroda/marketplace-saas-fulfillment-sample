@model SaaSAgentSample.Web.DemoMapVm
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@{
    var scenario = DemoNavigation.PurchaseScenario(Context.Request.Query["scenario"].ToString());
    var steps = new[]
    {
        (N: 1, Label: L["Microsoft purchase"].Value,
            Href: DemoNavigation.EmulatorLink(Config, DemoNavigation.PurchaseEntryPath, scenario), External: true),
        // A token-free link cannot open a purchased landing. Keep this step informational.
        (N: 2, Label: L["Partner activation"].Value, Href: (string?)null, External: false),
        (N: 3, Label: L["Partner contract DB"].Value,
            Href: (string?)DemoNavigation.PublisherLink("/admin", scenario), External: false),
        (N: 4, Label: L["Notification test"].Value,
            Href: DemoNavigation.EmulatorLink(Config, "/subscriptions.html", scenario), External: true),
    };
    var doneThrough = Model.CompletedThrough ?? 0;
}
<nav class="stepper" aria-label="@L["Teaching steps — links may switch role or system"]">
    @foreach (var s in steps)
    {
        var current = Model.Current == s.N;
        var done = s.N <= doneThrough;
        <div class="step @(s.External ? "external" : null) @(done ? "done" : null) @(current ? "current" : null)" aria-current="@(current ? "step" : null)">
            @if (s.Href is not null && !current)
            {
                <a class="step-head" href="@s.Href" target="@(s.External ? "_blank" : null)" rel="@(s.External ? "noopener" : null)">
                    <span class="n">@s.N</span><span class="lbl">@s.Label@(s.External ? " ↗" : "")</span>
                </a>
            }
            else
            {
                <span class="step-head"><span class="n">@s.N</span><span class="lbl">@s.Label</span></span>
            }
        </div>
    }
</nav>
