@page "/admin"
@using SaaSAgentSample.Core.Subscriptions
@model SaaSAgentSample.Web.Pages.Admin.IndexModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject SaaSAgentSample.Web.Services.ISubscriptionEventLog Events
@{
    ViewData["Title"] = L["Publisher admin — subscriptions"].Value;
    static string BadgeClass(SubscriptionState state) => state switch
    {
        SubscriptionState.Subscribed => "subscribed",
        SubscriptionState.Suspended => "suspended",
        SubscriptionState.Unsubscribed => "unsubscribed",
        _ => "pending",
    };
    var emu = SaaSAgentSample.Web.DemoNavigation.EmulatorUrl(Config);

    // What the map may tick off. A stored subscription proves step 1 happened; one that has left
    // PendingFulfillmentStart proves step 2 did, and this page is step 3 — so the tour's next stop
    // is step 4, in the emulator.
    if (Model.Subscriptions.Count > 0)
    {
        ViewData["DemoCompletedThrough"] =
            Model.Subscriptions.Any(s => s.State != SubscriptionState.PendingFulfillmentStart) ? 3 : 1;
    }
}
@* The data comes first. Everything explanatory sits below it, behind one summary. *@
<h1 class="page-title">@L["Subscriptions"]</h1>
<p class="subtitle">@L["Your subscription database. Read-only here."]</p>

@if (Model.Subscriptions.Count == 0)
{
    <div class="card"><p class="muted">@L["No subscriptions yet. Activate one from a buyer landing link to see it here."]</p></div>
}
else
{
    <div class="table-wrap">
        <table>
            <thead>
                <tr>
                    <th>@L["Marketplace subscription"]</th>
                    <th>@L["Plan"]</th>
                    <th>@L["State"]</th>
                    <th>@L["What changed it"]</th>
                    <th>@L["Remaining allowance"]</th>
                    <th>@L["Updated (UTC)"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Subscriptions)
                {
                    <tr>
                        <td>
                            <code>@s.MarketplaceSubscriptionId</code>
                            <span class="cell-sub">@(string.IsNullOrEmpty(s.Name) ? s.OfferId : s.Name)</span>
                        </td>
                        <td>@s.PlanId</td>
                        <td><span class="badge @BadgeClass(s.State)">@s.State</span></td>
                        <td>@(await Html.PartialAsync("_Provenance", new SaaSAgentSample.Web.ProvenanceVm(Events.For(s.MarketplaceSubscriptionId), s.State, true)))</td>
                        <td>@(await Html.PartialAsync("_CapacityBar", new SaaSAgentSample.Web.CapacityVm(s.MarketplaceSubscriptionId, s.PlanId, true)))</td>
                        <td class="muted nowrap">@s.UpdatedAt.UtcDateTime.ToString("u")</td>
                        <td><a href="/admin/@s.Id">@L["Details"]</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

@if (emu is not null)
{
    <p class="next-line">
        <span class="ico" aria-hidden="true">&#8644;</span>
        @L["Step 4 — change, suspend or cancel in the emulator. It arrives here as a webhook; reload to see it."]
        <a href="@(emu + "/subscriptions.html")" target="_blank" rel="noopener">@L["Open the emulator →"]</a>
    </p>
}

<details class="explainer learn" id="how">
    <summary>@L["How this works"]</summary>
    <div class="body">
        <h3 class="learn-h">@L["Who drives the lifecycle"]</h3>
        <p class="learn-lead">@L["Microsoft drives it. This app activates a purchase, then keeps its database in sync with the events Microsoft sends. It never invents state."]</p>
        <div class="lc-cols">
            <div class="lc-group">
                <span class="who pub">@L["Publisher-initiated"]</span>
                <ul>
                    <li>@L["Resolve → Activate — confirmed here, only from PendingFulfillmentStart. Starts billing."]</li>
                </ul>
            </div>
            <div class="lc-group">
                <span class="who ms">@L["Microsoft-initiated (webhook)"]</span>
                <ul>
                    <li>@L["Change plan / quantity"]</li>
                    <li>@L["Suspend / Reinstate (e.g. payment failure / recovery)"]</li>
                    <li>@L["Unsubscribe (terminal)"]</li>
                </ul>
            </div>
        </div>

        @(await Html.PartialAsync("_TruthLayers"))
        @(await Html.PartialAsync("_PlanChangeFigure"))
        @(await Html.PartialAsync("_KeyTerms"))
    </div>
</details>
