@page "/admin"
@using SaaSAgentSample.Core.Subscriptions
@model SaaSAgentSample.Web.Pages.Admin.IndexModel
@inject SaaSAgentSample.Core.Subscriptions.ISubscriptionEventLog Events
@{
    ViewData["Title"] = L["Publisher admin — subscriptions"].Value;
    static string BadgeClass(SubscriptionState state) => state switch
    {
        SubscriptionState.Subscribed => "subscribed",
        SubscriptionState.Suspended => "suspended",
        SubscriptionState.Unsubscribed => "unsubscribed",
        _ => "pending",
    };
    var scenario = DemoNavigation.PurchaseScenario(Model.Request.Query["scenario"].ToString());
    var selectedId = Model.MarketplaceSubscriptionId;
    var filtered = !string.IsNullOrEmpty(selectedId);
    var reloadPath = !string.IsNullOrEmpty(selectedId)
        ? Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString("/admin", "marketplaceSubscriptionId", selectedId)
        : "/admin";

    // What the map may tick off. A stored subscription proves step 1 happened; one that has left
    // PendingFulfillmentStart proves step 2 did, and this page is step 3 — so the tour's next stop
    // is step 4, in the emulator.
    if (Model.Subscriptions.Count > 0)
    {
        ViewData["DemoCompletedThrough"] =
            Model.Subscriptions.Any(s => s.State != SubscriptionState.PendingFulfillmentStart) ? 3 : 1;
    }
}
<h1 class="page-title">@L["Subscriptions"]</h1>
<p class="subtitle">@L["Saved partner contracts"]</p>
@if (filtered)
{
    <p class="contract-context">@L["Selected contract"]: <code>@Model.MarketplaceSubscriptionId</code> · <a href="@DemoNavigation.PublisherLink("/admin", scenario)">@L["View all saved contracts"]</a></p>
}

@if (Model.Subscriptions.Count == 0)
{
    <div class="card"><p class="muted">@(filtered ? L["No saved partner record was found for this purchase."] : L["No subscriptions yet. Activate one from a buyer landing link to see it here."])</p></div>
}
else
{
    <div class="table-wrap" tabindex="0" role="region" aria-label="@L["Saved partner contracts"]">
        <table>
            <caption class="data-source">@L["Source: partner contract DB"]</caption>
            <thead>
                <tr>
                    <th>@L["Marketplace subscription"]</th>
                    <th>@L["Plan"]</th>
                    <th>@L["State"]</th>
                    <th>@L["What changed it"]</th>
                    <th>@L["Remaining allowance"]</th>
                    <th>@L["Updated (UTC)"]</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model.Subscriptions)
                {
                    <tr>
                        <td>
                            <code>@s.MarketplaceSubscriptionId</code>
                            <span class="cell-sub">@(string.IsNullOrEmpty(s.Name) ? s.OfferId : s.Name)</span>
                        </td>
                        <td>@s.PlanId</td>
                        <td><span class="badge @BadgeClass(s.State)">@s.State</span></td>
                        <td>@(await Html.PartialAsync("_Provenance", new SaaSAgentSample.Web.ProvenanceVm(Events.For(s.MarketplaceSubscriptionId), s.State, true)))</td>
                        <td>@(await Html.PartialAsync("_CapacityBar", new SaaSAgentSample.Web.CapacityVm(s.MarketplaceSubscriptionId, s.PlanId, true)))</td>
                        <td class="muted nowrap">@s.UpdatedAt.UtcDateTime.ToString("u")</td>
                        <td class="nowrap"><a href="@DemoNavigation.PublisherLink($"/admin/{s.Id}", scenario)">@L["Details"]</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<p><a class="btn secondary" href="@DemoNavigation.PublisherLink(reloadPath, scenario)">@L["Reload partner company DB"]</a></p>
<p class="muted">@L["Open a contract to try a change and inspect its saved history."]</p>
