@page "/admin/{id:guid}"
@using SaaSAgentSample.Core.Subscriptions
@model SaaSAgentSample.Web.Pages.Admin.DetailModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject SaaSAgentSample.Core.Subscriptions.ISubscriptionEventLog Events
@{
    ViewData["Title"] = L["Subscription detail"].Value;
    var s = Model.Subscription;
    var scenario = DemoNavigation.PurchaseScenario(Model.Request.Query["scenario"].ToString());
    var emuRoot = DemoNavigation.EmulatorLink(Config, "/subscriptions.html", scenario);
    var emu = emuRoot is null || s is null ? null
        : Microsoft.AspNetCore.WebUtilities.QueryHelpers.AddQueryString(emuRoot, "subscriptionId", s.MarketplaceSubscriptionId);
    var history = s is null ? Array.Empty<SubscriptionEvent>() : Events.For(s.MarketplaceSubscriptionId);
    static string BadgeClass(SubscriptionState state) => state switch
    {
        SubscriptionState.Subscribed => "subscribed",
        SubscriptionState.Suspended => "suspended",
        SubscriptionState.Unsubscribed => "unsubscribed",
        _ => "pending",
    };

    // Same evidence as the list: a stored subscription means step 1 happened, and one past
    // PendingFulfillmentStart means step 2 did — which puts the tour's next stop at step 4.
    if (s is not null)
    {
        ViewData["DemoCompletedThrough"] = s.State == SubscriptionState.PendingFulfillmentStart ? 1 : 3;
    }
}
<p><a class="back-link" href="@DemoNavigation.PublisherLink("/admin", scenario)">@L["← All subscriptions"]</a></p>
<h1 class="page-title">@L["Subscription detail"]</h1>
<p class="subtitle">@L["Source: partner contract DB"]</p>

@if (Model.Message is not null)
{
    <div class="notice" role="status">@Model.Message</div>
}

@if (s is not null)
{
    <div class="card" style="max-width:640px">
        <dl class="kv">
            <dt>@L["Marketplace subscription"]</dt><dd><code>@s.MarketplaceSubscriptionId</code></dd>
            <dt>@L["Name"]</dt><dd>@(string.IsNullOrEmpty(s.Name) ? "—" : s.Name)</dd>
            <dt>@L["Offer"]</dt><dd>@s.OfferId</dd>
            <dt>@L["Plan"]</dt><dd>@s.PlanId</dd>
            <dt>@L["State"]</dt><dd><span class="badge @BadgeClass(s.State)">@s.State</span></dd>
            <dt>@L["Created (UTC)"]</dt><dd>@s.CreatedAt.UtcDateTime.ToString("u")</dd>
            <dt>@L["Updated (UTC)"]</dt><dd>@s.UpdatedAt.UtcDateTime.ToString("u")</dd>
        </dl>

        @if (Model.CanActivate)
        {
            <form method="post" action="@DemoNavigation.PublisherLink("?handler=Activate", scenario)">
                @Html.AntiForgeryToken()
                <p class="hint">@L["Activation calls the Fulfillment Activate API and starts billing. Confirm before proceeding."]</p>
                <button type="submit" class="btn primary">@L["Activate subscription"]</button>
            </form>
        }
    </div>
    <section class="change-exercise" aria-labelledby="change-title">
        <h2 id="change-title">@L["Follow one contract through a change"]</h2>
        <p>@L["Note the saved plan and state, make one change on the Microsoft side, then reload this record."]</p>
        <div class="exercise-actions">
            @if (emu is not null)
            {
                <a class="btn secondary same-contract-events" href="@emu" target="_blank" rel="noopener">@L["Try a change for this contract ↗"]</a>
            }
            <form class="reload-record" method="get" action="/admin/@s.Id#history">
                @* A fresh URL forces a server read even when the browser is already at #history. *@
                <input type="hidden" name="refresh" value="@Guid.NewGuid().ToString("N")" />
                <input type="hidden" name="culture" value="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName" />
                @if (scenario is not null)
                {
                    <input type="hidden" name="scenario" value="@scenario" />
                }
                <button class="btn secondary" type="submit">@L["Reload this saved record"]</button>
            </form>
        </div>
    </section>
    <details class="explainer learn" id="history">
        <summary>@L["Saved changes and processing history"]</summary>
        <div class="body">
            @(await Html.PartialAsync("_PlanHistory", history))
            @(await Html.PartialAsync("_Provenance", new SaaSAgentSample.Web.ProvenanceVm(history, s.State, false)))
            <p>@L["Notifications appear after receipt and database save. Reload to read the latest stored records; this screen cannot detect notifications still in transit."]</p>
        </div>
    </details>
    <details class="explainer learn">
        <summary>@L["Illustrative capacity"]</summary>
        <div class="body">@(await Html.PartialAsync("_CapacityBar", new SaaSAgentSample.Web.CapacityVm(s.MarketplaceSubscriptionId, s.PlanId, false)))</div>
    </details>
}
