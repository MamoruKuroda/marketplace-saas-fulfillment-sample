@page "/admin/{id:guid}"
@using SaaSAgentSample.Core.Subscriptions
@model SaaSAgentSample.Web.Pages.Admin.DetailModel
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject SaaSAgentSample.Core.Subscriptions.ISubscriptionEventLog Events
@{
    ViewData["Title"] = L["Subscription detail"].Value;
    var s = Model.Subscription;
    var scenario = DemoNavigation.PurchaseScenario(Model.Request.Query["scenario"].ToString());
    var emu = DemoNavigation.EmulatorLink(Config, "/subscriptions.html", scenario);
    static string BadgeClass(SubscriptionState state) => state switch
    {
        SubscriptionState.Subscribed => "subscribed",
        SubscriptionState.Suspended => "suspended",
        SubscriptionState.Unsubscribed => "unsubscribed",
        _ => "pending",
    };

    // Same evidence as the list: a stored subscription means step 1 happened, and one past
    // PendingFulfillmentStart means step 2 did — which puts the tour's next stop at step 4.
    if (s is not null)
    {
        ViewData["DemoCompletedThrough"] = s.State == SubscriptionState.PendingFulfillmentStart ? 1 : 3;
    }
}
<p><a class="back-link" href="@DemoNavigation.PublisherLink("/admin", scenario)">@L["← All subscriptions"]</a></p>
<h1 class="page-title">@L["Subscription detail"]</h1>
<p class="subtitle">@L["The partner company records and synchronizes contracts. This management UI is optional and can reuse existing tools."]</p>

@if (Model.Message is not null)
{
    <div class="notice">@Model.Message</div>
}

@if (s is not null)
{
    <div class="card" style="max-width:640px">
        <p class="hint">@L["Sample operations screen reading the partner company's contract DB. Not the emulator's state."]</p>
        <dl class="kv">
            <dt>@L["Marketplace subscription"]</dt><dd><code>@s.MarketplaceSubscriptionId</code></dd>
            <dt>@L["Name"]</dt><dd>@(string.IsNullOrEmpty(s.Name) ? "—" : s.Name)</dd>
            <dt>@L["Offer"]</dt><dd>@s.OfferId</dd>
            <dt>@L["Plan"]</dt><dd>@s.PlanId</dd>
            <dt>@L["State"]</dt><dd><span class="badge @BadgeClass(s.State)">@s.State</span></dd>
            <dt>@L["Created (UTC)"]</dt><dd>@s.CreatedAt.UtcDateTime.ToString("u")</dd>
            <dt>@L["Updated (UTC)"]</dt><dd>@s.UpdatedAt.UtcDateTime.ToString("u")</dd>
        </dl>

        @(await Html.PartialAsync("_Provenance", new SaaSAgentSample.Web.ProvenanceVm(Events.For(s.MarketplaceSubscriptionId), s.State, false)))

        @(await Html.PartialAsync("_CapacityBar", new SaaSAgentSample.Web.CapacityVm(s.MarketplaceSubscriptionId, s.PlanId, false)))

        @if (Model.CanActivate)
        {
            <form method="post" action="@DemoNavigation.PublisherLink("?handler=Activate", scenario)">
                @Html.AntiForgeryToken()
                <p class="hint">@L["Activation calls the Fulfillment Activate API and starts billing. Confirm before proceeding."]</p>
                <button type="submit" class="btn primary">@L["Activate subscription"]</button>
            </form>
        }
        else
        {
            <p class="muted">@L["No publisher actions available from the current state ({0}).", s.State]</p>
            <p class="hint" style="margin-top:.4rem">
                @L["Suspend, Reinstate, Change plan and Unsubscribe are Microsoft-initiated and arrive as a webhook. Trigger them in the emulator, then refresh."]
            </p>
            @if (emu is not null)
            {
                <p style="margin-top:.6rem"><a href="@emu" target="_blank" rel="noopener">@L["Demo role switch: Microsoft-side event operator ↗"]</a></p>
            }
            <p class="sync-notice">@L["Notifications appear after receipt and database save. Reload to read the latest stored records; this screen cannot detect notifications still in transit."]</p>
            <details class="explainer learn" id="how">
                <summary>@L["How this works"]</summary>
                <div class="body"><p>@L["Contract recording and synchronization belong to the partner implementation. This operations screen and its design are examples, not a required Marketplace management UI."]</p></div>
            </details>
        }
    </div>
}
